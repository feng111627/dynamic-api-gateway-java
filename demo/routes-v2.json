        { "id": "backend-1", "baseUrl": "http://127.0.0.1:18081" },
        { "id": "backend-2", "baseUrl": "http://127.0.0.1:18082" }
      ]
    },
    {
      "id": "payments",
      "pathPrefix": "/payments",
      "stickySession": false,
      "rateLimit": { "routeLimit": 10, "windowSeconds": 10 },
